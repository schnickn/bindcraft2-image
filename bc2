#!/bin/bash
# bc2 -- run BindCraft2 on Argon without editing job scripts or JSON by hand.
#
#   bc2 setup     one-time: download the container image and AlphaFold weights (runs as a batch job)
#   bc2 new       answer a few questions; creates a campaign (settings.json + resources)
#   bc2 run NAME  submit it to the queue (running it again resumes where it stopped)
#   bc2 status    what is running, how many designs are accepted
#   bc2 results   the best designs and how to copy them off Argon
#
# Run "bc2 help" for everything. Needs only bash and python3 (standard library), both on Argon.

set -u
BC2_VERSION="0.1"
BC2_HOME="${BC2_HOME:-$HOME/bc2}"
BC2_CONF="$BC2_HOME/config"
BC2_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
IMAGE_DEFAULT="${BC2_IMAGE:-ghcr.io/schnickn/bindcraft2:cuda12}"
CAMPAIGNS="$BC2_HOME/campaigns"
NEEDED_MODELS="model_1_multimer_v3 model_2_multimer_v3 model_3_multimer_v3 model_4_multimer_v3 model_5_multimer_v3 model_1_ptm model_2_ptm"

if [ -t 1 ]; then B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; C=$'\e[36m'; N=$'\e[0m'
else B=; D=; G=; Y=; R=; C=; N=; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
head1() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }

if [ -f "$BC2_HOME" ]; then
  die "$BC2_HOME is a file, probably this script, but bc2 keeps its data in a folder with that name. Move the script: mkdir -p ~/bin && mv $BC2_HOME ~/bin/bc2"
fi
command -v python3 >/dev/null 2>&1 || die "python3 not found. On Argon try:  module load python  (or use your own python3)"

# ---------------------------------------------------------------- python helpers (stdlib only)
read -r -d '' PYH <<'PYEOF'
import sys, os, re, csv, json, math, collections
import xml.etree.ElementTree as ET

def struct(path):
    """chains -> list of (resnum, icode) of CA atoms; or ('fasta', length)."""
    ext = os.path.splitext(path)[1].lower()
    if ext in ('.fasta', '.fa', '.faa'):
        seq = ''.join(l.strip() for l in open(path) if not l.startswith('>'))
        return {'fasta': len(seq)}
    chains = collections.OrderedDict()
    if ext in ('.pdb', '.ent'):
        for l in open(path):
            if l.startswith('ATOM') and l[12:16].strip() == 'CA' and l[16] in ' A':
                try:
                    key = (int(l[22:26]), l[26].strip())
                except ValueError:
                    continue
                chains.setdefault(l[21], set()).add(key)
        return chains
    if ext in ('.cif', '.mmcif'):
        import shlex
        lines = open(path).read().splitlines()
        i = 0
        while i < len(lines):
            if lines[i].strip() == 'loop_':
                j, cols = i + 1, []
                while j < len(lines) and lines[j].startswith('_atom_site.'):
                    cols.append(lines[j].strip()[len('_atom_site.'):]); j += 1
                if cols:
                    def col(*names):
                        for n in names:
                            if n in cols: return cols.index(n)
                        return None
                    ia, ic, ir, ii = col('label_atom_id'), col('auth_asym_id', 'label_asym_id'), col('auth_seq_id', 'label_seq_id'), col('pdbx_PDB_ins_code')
                    while j < len(lines) and not lines[j].startswith(('#', 'loop_', '_')):
                        f = shlex.split(lines[j])
                        j += 1
                        if len(f) < len(cols) or f[ia] != 'CA':
                            continue
                        try:
                            key = (int(f[ir]), '' if ii is None or f[ii] in '?.' else f[ii])
                        except ValueError:
                            continue
                        chains.setdefault(f[ic], set()).add(key)
                    return chains
            i += 1
        return chains
    raise SystemExit('unsupported file type %r (use .pdb, .cif or .fasta)' % ext)

def cmd_struct(path):
    s = struct(path)
    if 'fasta' in s:
        print('fasta\t%d' % s['fasta']); return
    for c, res in s.items():
        nums = sorted(r[0] for r in res)
        print('chain\t%s\t%d\t%d\t%d' % (c, len(res), nums[0], nums[-1]))

def cmd_hotspots(path, chains, spots):
    s = struct(path)
    sel = [c for c in chains.split(',') if c] if chains else list(s.keys())
    bad = []
    for c in sel:
        if c not in s: bad.append('chain %s is not in the file (it has: %s)' % (c, ', '.join(s.keys())))
    if bad:
        print('\n'.join(bad)); sys.exit(1)
    for tok in [t.strip() for t in spots.split(',') if t.strip()]:
        m = re.match(r'^([A-Za-z]*)(\d+)(?:-(\d+))?$', tok)
        if not m:
            bad.append("'%s' is not a residue like 54, A54, or A12-16" % tok); continue
        ch = m.group(1) or sel[0]
        lo = int(m.group(2)); hi = int(m.group(3) or lo)
        if ch not in sel:
            bad.append("'%s' uses chain %s, which is not one of the chains you picked (%s)" % (tok, ch, ','.join(sel))); continue
        have = set(r[0] for r in s[ch])
        missing = [n for n in range(lo, hi + 1) if n not in have]
        if hi < lo: bad.append("'%s' goes backwards" % tok)
        elif len(missing) == hi - lo + 1: bad.append("'%s': chain %s has no residues numbered %d-%d (it runs %d-%d)" % (tok, ch, lo, hi, min(have), max(have)))
        elif missing: bad.append("'%s': chain %s is missing residue(s) %s" % (tok, ch, ','.join(map(str, missing[:6]))))
    if bad:
        print('\n'.join(bad)); sys.exit(1)

def est(n):
    return 2.0 * (3.4 + 38000 * n * n / 1e9)

CARDS = [('L40S 48GB', 44.5), ('A40 48GB', 44.5), ('A100 80GB', 79.0), ('V100 32GB', 31.5)]

def cmd_estimate(target, binder):
    n = int(math.ceil((int(target) + int(binder)) / 32.0)) * 32
    e = est(n)
    print('n\t%d' % n); print('gib\t%.1f' % e)
    for name, free in CARDS:
        print('fit\t%s\t%d' % (name, max(0, int((free - 4.0) // e))))

def cmd_mksettings(out):
    g = os.environ.get
    d = collections.OrderedDict()
    d['campaign_name'] = g('BC_NAME')
    if g('BC_KIND') == 'shipped':
        d['target'] = g('BC_TARGET')
    else:
        t = collections.OrderedDict()
        t['name'] = re.sub(r'[^A-Za-z0-9_]+', '_', os.path.splitext(os.path.basename(g('BC_TARGET')))[0])
        t['target_path'] = os.path.basename(g('BC_TARGET'))
        if g('BC_CHAINS'): t['chains'] = g('BC_CHAINS')
        if g('BC_HOTSPOTS'): t['hotspots'] = g('BC_HOTSPOTS')
        d['targets'] = [t]
    mods = [m for m in g('BC_MODALITY', 'binder').split(',') if m]
    d['modality'] = mods[0] if len(mods) == 1 else mods
    for p in [p for p in g('BC_PROPS', '').split(',') if p]:
        d[p] = True
    if g('BC_LEN_MIN'):
        d['binder_lengths'] = [int(g('BC_LEN_MIN')), int(g('BC_LEN_MAX') or g('BC_LEN_MIN'))]
    d['number_of_final_designs'] = int(g('BC_NFINAL', '10'))
    if g('BC_MAXTRAJ'): d['max_trajectories'] = int(g('BC_MAXTRAJ'))
    if g('BC_WORKERS'): d['workers_per_gpu'] = int(g('BC_WORKERS'))
    d['project_folder'] = 'results'
    with open(out, 'w') as f:
        json.dump(d, f, indent=2); f.write('\n')

def count_rows(p):
    try:
        with open(p) as f:
            return max(0, sum(1 for _ in f) - 1)
    except IOError:
        return 0

def cmd_progress(camp):
    try:
        want = json.load(open(os.path.join(camp, 'settings.json'))).get('number_of_final_designs', 1)
        mt = json.load(open(os.path.join(camp, 'settings.json'))).get('max_trajectories')
    except Exception:
        want, mt = '?', None
    acc = count_rows(os.path.join(camp, 'results', '3_Ranked', '!_Ranked.csv'))
    tra = count_rows(os.path.join(camp, 'results', '1_Trajectories', '!_Trajectories.csv'))
    print('%s\t%s\t%s\t%s' % (acc, want, tra, mt if mt else '-'))

def cmd_ranked(camp, n):
    p = os.path.join(camp, 'results', '3_Ranked', '!_Ranked.csv')
    if not os.path.exists(p):
        print('(no accepted designs yet)'); return
    rows = list(csv.DictReader(open(p)))
    cols = [c for c in ('rank', 'design', 'length', 'i_pTM', 'i_pAE', 'i_pDAE', 'pLDDT') if rows and c in rows[0]]
    print('  '.join('%-10s' % c if c != 'design' else '%-52s' % c for c in cols))
    for r in rows[:int(n)]:
        out = []
        for c in cols:
            v = r[c]
            try:
                if c not in ('rank', 'length', 'design'): v = '%.2f' % float(v)
            except ValueError:
                pass
            out.append('%-52s' % v if c == 'design' else '%-10s' % v)
        print('  '.join(out))
    print('(%d accepted in total)' % len(rows))

def cmd_jobs():
    try:
        root = ET.fromstring(sys.stdin.read())
    except ET.ParseError:
        return
    for j in root.iter('job_list'):
        g = lambda t: (j.findtext(t) or '').strip()
        print('\t'.join([g('JB_name'), g('JB_job_number'), g('state'), g('queue_name') or '-']))

def cmd_jsoncheck(p):
    try:
        json.load(open(p))
    except Exception as e:
        print(e); sys.exit(1)

if __name__ == '__main__':
    globals()['cmd_' + sys.argv[1]](*sys.argv[2:])
PYEOF
py() { python3 -c "$PYH" "$@"; }

# ---------------------------------------------------------------- prompts
ask() {   # ask VAR "Question" [default]     (locals are __-prefixed so they never shadow the caller's VAR)
  local __v="$1" __q="$2" __d="${3:-}" __a
  if [ -n "$__d" ]; then read -e -r -p "$__q [$__d]: " __a || die "input ended"; __a="${__a:-$__d}"
  else read -e -r -p "$__q: " __a || die "input ended"; fi
  __a="${__a/#\~/$HOME}"
  printf -v "$__v" '%s' "$__a"
}
ask_yn() {  # ask_yn VAR "Question" y|n
  local __v="$1" __q="$2" __d="${3:-y}" __a __h="Y/n"
  [ "$__d" = n ] && __h="y/N"
  while true; do
    read -e -r -p "$__q [$__h]: " __a || die "input ended"
    __a="${__a:-$__d}"
    case "$__a" in y|Y|yes|YES) printf -v "$__v" y; return;; n|N|no|NO) printf -v "$__v" n; return;; esac
    say "  please answer y or n"
  done
}
ask_num() {  # ask_num VAR "Question" default min max
  local __v="$1" __q="$2" __d="$3" __lo="$4" __hi="$5" __r
  while true; do
    ask __r "$__q" "$__d"
    if [[ "$__r" =~ ^[0-9]+$ ]] && [ "$__r" -ge "$__lo" ] && [ "$__r" -le "$__hi" ]; then printf -v "$__v" '%s' "$__r"; return; fi
    say "  enter a whole number from $__lo to $__hi"
  done
}
menu() {  # menu VAR default_index "Title" item...   (numbered list; sets VAR to the 1-based choice)
  local __v="$1" __d="$2" __t="$3"; shift 3
  local __i=1 __item
  say ""; say "$__t"
  for __item in "$@"; do printf '  %s%d)%s %s\n' "$C" "$__i" "$N" "$__item"; __i=$((__i+1)); done
  ask_num "$__v" "Choose" "$__d" 1 $#
}

# ---------------------------------------------------------------- config
load_config() {
  SIF="$BC2_HOME/bindcraft2.sif"; AF2DIR="$BC2_HOME/weights/alphafold"; IMAGE="$IMAGE_DEFAULT"
  # shellcheck disable=SC1090
  [ -f "$BC2_CONF" ] && . "$BC2_CONF"
}
save_config() {
  mkdir -p "$BC2_HOME"
  printf 'SIF=%q\nAF2DIR=%q\nIMAGE=%q\n' "$SIF" "$AF2DIR" "$IMAGE" > "$BC2_CONF"
}
weights_ok() {  # does $1 hold the AlphaFold models BindCraft2 needs?
  local d="$1" m
  [ -d "$d" ] || return 1
  for m in $NEEDED_MODELS; do
    [ -s "$d/params_$m.npz" ] || [ -s "$d/params/params_$m.npz" ] || return 1
  done
}
resolve_weights_dir() {  # given a directory, print the one that holds params_*.npz
  local d="$1"
  for c in "$d" "$d/alphafold" "$d/params" "$d/alphafold/params"; do
    if ls "$c"/params_*.npz >/dev/null 2>&1; then printf '%s' "$c"; return 0; fi
  done
  return 1
}

# ---------------------------------------------------------------- bc2 setup
cmd_setup() {
  local here=n sif_arg="" w_arg="" image="" slots=4
  while [ $# -gt 0 ]; do
    case "$1" in
      --here) here=y;;
      --sif) sif_arg="$2"; shift;;
      --weights) w_arg="$2"; shift;;
      --image) image="$2"; shift;;
      -h|--help) cat <<EOF
bc2 setup [--here] [--sif FILE] [--weights DIR] [--image NAME]

One-time install into $BC2_HOME. By default it submits a batch job that
  1. downloads the BindCraft2 container image ($IMAGE_DEFAULT)  (about 7 GB)
  2. downloads the AlphaFold model weights                            (about 5 GB)
so nothing heavy runs on the login node. Safe to run again: finished parts are skipped.

  --here          do it right here instead of as a job (use if batch nodes cannot reach the internet)
  --sif FILE      use a container image someone already shared with you instead of downloading
  --weights DIR   use a folder that already holds params_model_*.npz instead of downloading
  --image NAME    download a different image (default $IMAGE_DEFAULT)
EOF
        return 0;;
      *) die "unknown option $1 (try: bc2 setup --help)";;
    esac
    shift
  done
  load_config
  [ -n "$image" ] && IMAGE="$image"
  mkdir -p "$BC2_HOME/logs" "$CAMPAIGNS" "$BC2_HOME/xla_cache" "$BC2_HOME/weights"
  [ -n "$sif_arg" ] && { [ -s "$sif_arg" ] || die "no such file: $sif_arg"; SIF="$(cd "$(dirname "$sif_arg")" && pwd)/$(basename "$sif_arg")"; }
  if [ -n "$w_arg" ]; then
    local r; r="$(resolve_weights_dir "$w_arg")" || die "no params_*.npz files found in $w_arg (or its alphafold/ or params/ subfolder)"
    AF2DIR="$r"
  fi
  save_config
  head1 "BindCraft2 setup"
  say "  install folder : $BC2_HOME"
  say "  image          : $SIF"
  say "  AF2 weights    : $AF2DIR"
  local need_sif=n need_w=n
  [ -s "$SIF" ] || need_sif=y
  weights_ok "$AF2DIR" || need_w=y
  if [ $need_sif = n ] && [ $need_w = n ]; then ok "everything is already in place"; cmd_check; return $?; fi
  [ $need_sif = y ] && say "  -> will download the container image"
  [ $need_w = y ] && say "  -> will download the AlphaFold weights"

  local job="$BC2_HOME/setup.job"
  cat > "$job" <<EOF
#!/bin/bash
# generated by bc2 setup
export APPTAINER_CACHEDIR="\$TMPDIR/apptainer_cache" APPTAINER_TMPDIR="\$TMPDIR/apptainer_tmp"
mkdir -p "\$APPTAINER_CACHEDIR" "\$APPTAINER_TMPDIR"
echo "setup started \$(date) on \$(hostname)"
if [ ! -s "$SIF" ]; then
  echo "== downloading $IMAGE (several minutes; most of the time is packing the image)"
  apptainer pull -F "$SIF.partial" "docker://$IMAGE" 2>&1 | grep -v -E 'warn xattr|^\$' | tail -20
  [ -s "$SIF.partial" ] && mv "$SIF.partial" "$SIF" || { echo "image download FAILED"; exit 1; }
fi
if ! bash "$BC2_SELF" _weights_ok; then
  echo "== downloading AlphaFold weights (about 5 GB)"
  mkdir -p "$BC2_HOME/weights"
  APPTAINERENV_BINDCRAFT_WEIGHTS=/w apptainer exec -e --bind "$BC2_HOME/weights:/w" "$SIF" bindcraft fetch-weights 2>&1 | tr '\\r' '\\n' | grep -v -E 'GreenCtx|cuda-nvcc|^ *[0-9.]+ of [0-9.]+ GB *\$' | tail -5
fi
echo "== checking"
bash "$BC2_SELF" check
echo "setup finished \$(date)"
EOF
  chmod +x "$job"
  if [ $here = y ]; then
    say ""; say "Running here (this can take 30+ minutes; if your connection drops it stops, so run it inside 'screen')..."
    TMPDIR="${TMPDIR:-$BC2_HOME/tmp}"; mkdir -p "$TMPDIR"; export TMPDIR
    bash "$job" 2>&1 | tee "$BC2_HOME/logs/setup.here.log"
    return 0
  fi
  local out id
  out="$(qsub -S /bin/bash -wd "$BC2_HOME" -j y -o "$BC2_HOME/logs/" -N bc2_setup -q UI -pe smp 4 "$job" 2>&1)" || die "qsub failed: $out"
  id="$(printf '%s\n' "$out" | sed -n 's/^Your job \([0-9]*\).*/\1/p' | head -1)"
  [ -n "$id" ] || die "could not read the job number from: $out"
  say ""
  ok "setup job $id submitted"
  say "  watch it :  tail -f $BC2_HOME/logs/bc2_setup.o$id"
  say "  when it prints 'setup finished', run:  bc2 new"
}

# ---------------------------------------------------------------- bc2 check
cmd_check() {
  load_config
  local bad=0
  head1 "BindCraft2 install check"
  command -v apptainer >/dev/null 2>&1 && ok "apptainer: $(apptainer --version 2>/dev/null)" || { warn "apptainer not found (are you on an Argon login node?)"; bad=1; }
  command -v qsub >/dev/null 2>&1 && ok "qsub (SGE) available" || { warn "qsub not found (are you on an Argon login node?)"; bad=1; }
  if [ -s "$SIF" ]; then ok "container image: $SIF ($(du -h "$SIF" | cut -f1))"; else warn "container image missing: $SIF  -> run: bc2 setup"; bad=1; fi
  if weights_ok "$AF2DIR"; then ok "AlphaFold weights: $AF2DIR"; else warn "AlphaFold weights incomplete in $AF2DIR  -> run: bc2 setup"; bad=1; fi
  [ $bad = 0 ] && ok "ready: try  bc2 new" || return 1
}

