PROP_NAMES=(humanize forced_targeting disulfide_staple mixed_topology protease_stable termini_accessible termini_together hard_target large_complex)
PROP_DESC=("humanize           human-like sequence preferences (good for therapeutics)"
           "forced_targeting   concentrate the binder on your hotspots"
           "disulfide_staple   allow cysteine and require a disulfide bond"
           "mixed_topology     at most 50% helix and at least 20% beta sheet"
           "protease_stable    avoid protease cleavage motifs and exposed loops"
           "termini_accessible point both chain ends away from the target"
           "termini_together   bring the N and C termini within 10 A"
           "hard_target        re-predict accepted designs from the folded pose (for hard targets)"
           "large_complex      start gradient stages from the coordinates on hand (for large complexes)")

# Property names change between BindCraft2 versions (1.0.4 renamed bigbang to large_complex and
# initial_guess to hard_target), so ask the installed image which ones it has: keep the described
# ones it still knows, and add any new ones with a plain label. Falls back to the table above.
refresh_props() {
  [ -s "$SIF" ] || return 0
  local cache="$BC2_HOME/.properties" have="" i n
  if [ ! -s "$cache" ] || [ "$SIF" -nt "$cache" ]; then
    apptainer exec -e "$SIF" bindcraft design --list-properties 2>/dev/null | grep -E '^[a-z][a-z0-9_]*$' > "$cache.tmp" 2>/dev/null && mv -f "$cache.tmp" "$cache"
    rm -f "$cache.tmp"
  fi
  [ -s "$cache" ] || return 0
  have="$(tr '\n' ' ' < "$cache")"
  local nn=() dd=()
  for i in "${!PROP_NAMES[@]}"; do
    case " $have " in *" ${PROP_NAMES[$i]} "*) nn+=("${PROP_NAMES[$i]}"); dd+=("${PROP_DESC[$i]}");; esac
  done
  for n in $have; do
    case " ${nn[*]-} " in *" $n "*) ;; *) nn+=("$n"); dd+=("$(printf '%-19s' "$n") (new in this BindCraft2 version; see its documentation)");; esac
  done
  PROP_NAMES=("${nn[@]}"); PROP_DESC=("${dd[@]}")
}

pick_many() {  # pick_many VAR "Title" default_text names... :: descs...  (reads comma separated numbers)
  :
}

ask_resources() {  # uses/sets: RQUEUE RGPU RSLOTS RWORKERS ; args: target_residues_for_estimate (0 = unknown) max_binder
  local tres="${1:-0}" mb="${2:-0}" est_n=0 fitline="" best=1 qs q gi
  head1 "Where to run it"
  if [ "$tres" -gt 0 ] && [ "$mb" -gt 0 ]; then
    local line
    while IFS=$'\t' read -r k a b c; do
      case "$k" in n) est_n="$a";; gib) est_gib="$a";; fit) fitline="$fitline$a: $b worker(s)   ";; esac
    done < <(py estimate "$tres" "$mb")
    say "  Size estimate: target $tres + binder up to $mb residues = about $est_n residues folded."
    say "  BindCraft2 estimates ~${est_gib} GB of GPU memory per worker (real use measured ~25-35% lower)."
    say "  Workers that fit on one card:  $fitline"
  else
    say "  (no size estimate for this binder type; start with 1 worker and watch memory in 'bc2 status')"
  fi
  RGPU_LIST=(L40S A40 A100 V100 any)
  menu gi 1 "GPU type  (all four have been tested with BindCraft2 on Argon)" \
    "L40S   48 GB  recommended: widely available" \
    "A40    48 GB  also widely available" \
    "A100   80 GB  fits the most workers at once, but UI-GPU often has a long wait; all.q starts fast but can be interrupted" \
    "V100   32 GB  works, roughly 60% slower" \
    "any    let the scheduler pick (excludes small old cards)"
  RGPU="${RGPU_LIST[$((gi-1))]}"
  qs="$(whichq 2>/dev/null | grep -E '^(UI-GPU|CCOM-GPU|UI-GPU-HM|all.q)$' | tr '\n' ' ')"
  [ -n "$qs" ] || qs="UI-GPU all.q"
  local qopts=() qdesc=() qq
  for qq in $qs; do
    qopts+=("$qq")
    case "$qq" in
      UI-GPU)     qdesc+=("UI-GPU      everyone; 1 running job at a time; never interrupted  (recommended)");;
      CCOM-GPU)   qdesc+=("CCOM-GPU    your group's queue (L40S only); up to 5 jobs at once");;
      UI-GPU-HM)  qdesc+=("UI-GPU-HM   big-memory GPU nodes; 24 h limit");;
      all.q)      qdesc+=("all.q       no job limit, but can be interrupted at any time; rerun 'bc2 run' to resume");;
    esac
  done
  local qdef=1 i
  for i in "${!qopts[@]}"; do [ "${qopts[$i]}" = UI-GPU ] && qdef=$((i+1)); done
  menu q "$qdef" "Queue" "${qdesc[@]}"
  RQUEUE="${qopts[$((q-1))]}"
  [ "$RQUEUE" = CCOM-GPU ] && [ "$RGPU" != L40S ] && { warn "CCOM-GPU only has L40S cards; using L40S"; RGPU=L40S; }
  local wdef=2
  [ -n "$fitline" ] && { case "$fitline" in *"L40S 48GB: 1 "*|*"L40S 48GB: 0 "*) wdef=1;; esac; }
  [ "$tres" -le 0 ] && wdef=1
  say ""
  say "  Workers share one GPU to design in parallel (tested up to 3 per card)."
  ask_num RWORKERS "Workers per GPU" "$wdef" 1 8
  RSLOTS=8; [ "$RWORKERS" -ge 3 ] && RSLOTS=12; [ "$RWORKERS" -ge 5 ] && RSLOTS=16
  say "  Memory: asking for $RSLOTS slots (about $((RSLOTS*4)) GB of RAM). Measured peak with up to 3 workers was 11-14 GB."
}

write_cfg() {  # write_cfg dir
  printf 'RQUEUE=%q\nRGPU=%q\nRSLOTS=%q\n' "$RQUEUE" "$RGPU" "$RSLOTS" > "$1/bc2.cfg"
}

create_campaign_files() {  # expects BC_* env set; BC_NAME decides dir
  local dir; dir="$(camp_dir "$BC_NAME")"
  mkdir -p "$dir/logs"
  if [ "$BC_KIND" = file ]; then
    cp "$BC_TARGET" "$dir/$(basename "$BC_TARGET")" || die "could not copy $BC_TARGET"
  fi
  py mksettings "$dir/settings.json"
  write_cfg "$dir"
}

cmd_new() {
  load_config
  local name="${1:-}"
  head1 "New BindCraft2 campaign"
  say "I will ask a few questions and write the files for you. Press Enter to accept the [default]."
  say "(You can stop with Ctrl-C at any time; nothing is submitted until the end.)"
  weights_ok "$AF2DIR" && [ -s "$SIF" ] || warn "the install is not finished yet (run: bc2 check)"

  while true; do
    ask name "Name for this campaign (letters, numbers, - and _)" "$name"
    valid_name "$name" || { say "  use only letters, numbers, - and _ (no spaces)"; name=""; continue; }
    if [ -f "$(camp_dir "$name")/settings.json" ]; then
      local ow; ask_yn ow "  '$name' already exists. Overwrite its settings? (results are kept)" n
      [ "$ow" = y ] && break; name=""; continue
    fi
    break
  done

  # ---- target
  local tk tres=0 chains="" hot="" kind target
  menu tk 1 "What do you want to design a binder against?" \
    "A target BindCraft2 already includes (PD-L1, IL-2R, ...)" \
    "My own structure file (.pdb, .cif) or sequence (.fasta)"
  if [ "$tk" = 1 ]; then
    kind=shipped
    local sh; menu sh 1 "Included targets" "${SHIPPED_DESC[@]}"
    target="${SHIPPED_NAMES[$((sh-1))]}"; tres="${SHIPPED_RES[$((sh-1))]}"
  else
    kind=file
    while true; do
      ask target "Path to your target file (Tab completes paths)"
      [ -f "$target" ] || { say "  no such file: $target"; continue; }
      py struct "$target" > "$BC2_HOME/.struct.tmp" 2> "$BC2_HOME/.struct.err" || { say "  $(cat "$BC2_HOME/.struct.err")"; continue; }
      break
    done
    say ""
    local firstchain="" nch=0 line
    if grep -q '^fasta' "$BC2_HOME/.struct.tmp"; then
      tres="$(cut -f2 "$BC2_HOME/.struct.tmp")"
      say "  Sequence target with $tres residues. BindCraft2 will sample a window of it."
      [ "$tres" -gt 40 ] && tres=40
    else
      say "  Found these chains in $(basename "$target"):"
      while IFS=$'\t' read -r k c n lo hi; do
        printf '    chain %s : %s residues (numbered %s-%s)\n' "$c" "$n" "$lo" "$hi"
        [ -z "$firstchain" ] && firstchain="$c"; nch=$((nch+1))
      done < <(grep '^chain' "$BC2_HOME/.struct.tmp")
      while true; do
        ask chains "Which chain(s) are the target? (e.g. A or A,B)" "$firstchain"
        chains="${chains// /}"
        local tot=0 ok1=y c
        for c in ${chains//,/ }; do
          line="$(awk -F'\t' -v c="$c" '$1=="chain" && $2==c {print $3}' "$BC2_HOME/.struct.tmp")"
          if [ -z "$line" ]; then say "  chain $c is not in the file"; ok1=n; break; fi
          tot=$((tot+line))
        done
        [ $ok1 = y ] && { tres=$tot; break; }
      done
      say ""
      say "  ${D}Hotspots are the target residues you want the binder to touch (optional but recommended).${N}"
      say "  ${D}Use residue numbers from your file, like: 54,56,66-70   (with several chains: A54,B12-16)${N}"
      while true; do
        ask hot "Hotspot residues (Enter to skip)" ""
        [ -z "$hot" ] && break
        hot="${hot// /}"
        if msg="$(py hotspots "$target" "$chains" "$hot")"; then break; else say "$msg" | sed 's/^/  /'; fi
      done
    fi
  fi

  # ---- binder type
  local mi picks mods="" props="" haslen=n
  say ""; say "${B}What kind of binder?${N}  (pick one, or several separated by commas, e.g. 1,11)"
  local i=1; for d in "${MOD_DESC[@]}"; do printf '  %s%2d)%s %s\n' "$C" "$i" "$N" "$d"; i=$((i+1)); done
  while true; do
    ask picks "Choose" "1"
    mods=""; local okp=y p
    for p in ${picks//,/ }; do
      if [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le ${#MOD_NAMES[@]} ]; then mods="$mods${mods:+,}${MOD_NAMES[$((p-1))]}"; else okp=n; fi
    done
    [ $okp = y ] && [ -n "$mods" ] && break
    say "  enter numbers from 1 to ${#MOD_NAMES[@]}, separated by commas"
  done
  for p in ${mods//,/ }; do case "$LEN_MODS" in *" $p "*) haslen=y;; esac; done

  local lmin="" lmax="" mb=0
  if [ $haslen = y ]; then
    say ""
    say "  ${D}Binder length in amino acids. A range lets BindCraft2 try different sizes; Enter keeps the preset.${N}"
    while true; do
      ask lmin "Shortest binder (Enter = preset)" ""
      [ -z "$lmin" ] && break
      if [[ "$lmin" =~ ^[0-9]+$ ]] && [ "$lmin" -ge 5 ]; then
        ask lmax "Longest binder" "$lmin"
        if [[ "$lmax" =~ ^[0-9]+$ ]] && [ "$lmax" -ge "$lmin" ]; then mb="$lmax"; break; fi
        say "  the longest must be a number at least $lmin"
      else say "  enter a number of at least 5"; fi
    done
    case ",$mods," in *,large_binder,*) [ -z "$lmin" ] && warn "large_binder works best when you give lengths too.";; esac
    [ -z "$lmin" ] && lmax=""
  fi
  [ $haslen = y ] && [ "$mb" -eq 0 ] && mb=180   # assume the longest default range for the estimate
  [ $haslen = n ] && mb=0

  refresh_props
  say ""; say "${B}Extra design properties${N}  (optional; comma-separated numbers, Enter for none)"
  i=1; for d in "${PROP_DESC[@]}"; do printf '  %s%d)%s %s\n' "$C" "$i" "$N" "$d"; i=$((i+1)); done
  while true; do
    ask picks "Choose" ""
    props=""; okp=y
    for p in ${picks//,/ }; do
      if [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le ${#PROP_NAMES[@]} ]; then props="$props${props:+,}${PROP_NAMES[$((p-1))]}"; else okp=n; fi
    done
    [ $okp = y ] && break
    say "  enter numbers from 1 to ${#PROP_NAMES[@]}, or press Enter for none"
  done

  # ---- how many
  local nfinal maxtraj
  say ""
  ask_num nfinal "How many accepted designs do you want?" 10 1 100000
  say "  ${D}Most attempts are rejected by the quality filters, so many attempts are needed per accepted design.${N}"
  say "  ${D}A cap stops a hard target from using the GPU forever. Enter 0 for no cap.${N}"
  ask_num maxtraj "Give up after how many attempts?" 500 0 1000000
  [ "$maxtraj" = 0 ] && maxtraj=""

  ask_resources "$tres" "$mb"

  export BC_NAME="$name" BC_KIND="$kind" BC_TARGET="$target" BC_CHAINS="$chains" BC_HOTSPOTS="$hot" \
         BC_MODALITY="$mods" BC_PROPS="$props" BC_LEN_MIN="$lmin" BC_LEN_MAX="$lmax" \
         BC_NFINAL="$nfinal" BC_MAXTRAJ="$maxtraj" BC_WORKERS="$RWORKERS"
  create_campaign_files
  local dir; dir="$(camp_dir "$name")"
  head1 "Campaign '$name' is ready"
  say "  folder   : $dir"
  say "  settings : $dir/settings.json"
  say ""; sed 's/^/    /' "$dir/settings.json"; say ""
  say "  runs on  : ${RGPU} GPU in queue ${RQUEUE}, ${RSLOTS} slots"
  say "  ${D}Change the settings later with:  bc2 edit $name   (or resources: bc2 resources $name)${N}"
  local go; ask_yn go "Submit it to the queue now?" y
  if [ "$go" = y ]; then cmd_run "$name"; else say "Submit later with:  bc2 run $name"; fi
}

# ---------------------------------------------------------------- bc2 run
gpu_flags() {  # prints qsub resource flags for $RGPU
  case "$1" in
    any) printf -- '-l ngpus=1 -l gpu_1080ti=false -l gpu_2080ti=false -l gpu_titanv=false -l gpu_titanv_jhh=false -l gpu_l4=false -l gpu_p40=false -l gpu_p100=false -l gpu_k80=false';;
    L40S) printf -- '-l ngpus=1 -l gpu_l40s=true';;
    A40)  printf -- '-l ngpus=1 -l gpu_a40=true';;
    A100) printf -- '-l ngpus=1 -l gpu_a100=true';;
    V100) printf -- '-l ngpus=1 -l gpu_v100=true';;
    *) die "unknown GPU type '$1'";;
  esac
}

write_job() {  # write_job dir name
  local dir="$1" name="$2"
  cat > "$dir/job.sh" <<EOF
#!/bin/bash
# generated by bc2 -- do not edit; change settings.json or run 'bc2 resources $name'
export APPTAINERENV_BINDCRAFT_AF2_PARAMS=/af2params
export APPTAINERENV_JAX_COMPILATION_CACHE_DIR=/xla_cache
[ -n "\${CUDA_VISIBLE_DEVICES:-}" ] && export APPTAINERENV_CUDA_VISIBLE_DEVICES="\$CUDA_VISIBLE_DEVICES"
cd "$dir" || exit 1
echo "campaign $name on \$(hostname) at \$(date)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null | head -2
stop() { echo; echo "*** job was stopped (cancelled, or interrupted on all.q). Run: bc2 run $name   to continue where it left off."; kill \$child 2>/dev/null; wait \$child 2>/dev/null; exit 143; }
trap stop TERM INT
apptainer exec -e --bind "$AF2DIR:/af2params" --bind "$BC2_HOME/xla_cache:/xla_cache" --bind "$dir:$dir" --pwd "$dir" "$SIF" bindcraft design settings.json > >(grep -v -E 'GreenCtx|cuda-nvcc') 2>&1 &
child=\$!
wait \$child
echo "campaign finished (exit \$?) at \$(date)"
EOF
  chmod +x "$dir/job.sh"
}

cmd_run() {
  local name="" dry=n a
  for a in "$@"; do case "$a" in --dry-run) dry=y;; -*) die "unknown option $a";; *) name="$a";; esac; done
  need_camp "$name"
  load_config
  [ -s "$SIF" ] || die "container image missing ($SIF). Run: bc2 setup"
  weights_ok "$AF2DIR" || die "AlphaFold weights are not set up. Run: bc2 setup"
  local dir; dir="$(camp_dir "$name")"
  err="$(py jsoncheck "$dir/settings.json")" || die "settings.json is not valid JSON: $err"
  [ -f "$dir/bc2.cfg" ] && . "$dir/bc2.cfg" || die "missing resources file; run: bc2 resources $name"
  if qstat -u "$USER" -xml 2>/dev/null | py jobs | awk -F'\t' -v n="bc2_$name" '$1==n{f=1} END{exit !f}'; then
    die "'$name' is already queued or running (see: bc2 status $name)"
  fi
  mkdir -p "$dir/logs"
  write_job "$dir" "$name"
  local flags; flags="$(gpu_flags "$RGPU")"
  local base=(-S /bin/bash -wd "$dir" -j y -o "$dir/logs/" -N "bc2_$name" -q "$RQUEUE" -pe smp "$RSLOTS" -l mps=4)
  # shellcheck disable=SC2206
  local all=("${base[@]}" $flags "$dir/job.sh")
  local vout
  vout="$(qsub -w v "${all[@]}" 2>&1)" || true
  case "$vout" in *"found suitable queue"*) ;; *) die "the scheduler will not accept this request:"$'\n'"$vout"$'\n'"Try: bc2 resources $name";; esac
  if [ $dry = y ]; then ok "dry run: the request is valid ($RGPU, queue $RQUEUE, $RSLOTS slots). Nothing submitted."; say "  qsub ${all[*]}"; return 0; fi
  local out id
  out="$(qsub "${all[@]}" 2>&1)" || die "qsub failed: $out"
  id="$(printf '%s\n' "$out" | sed -n 's/^Your job \([0-9]*\).*/\1/p' | head -1)"
  ok "submitted '$name' as job ${id:-?}  ($RGPU, queue $RQUEUE)"
  say "  see progress :  bc2 status $name"
  say "  live log     :  tail -f $dir/logs/bc2_$name.o${id:-JOBID}"
  say "  stop it      :  bc2 cancel $name      (run again later to resume)"
}

# ---------------------------------------------------------------- status, results, cancel, list, edit, resources
job_of() {  # print "id state queue" for campaign $1 if queued/running
  qstat -u "$USER" -xml 2>/dev/null | py jobs | awk -F'\t' -v n="bc2_$1" '$1==n {print $2" "$3" "$4}' | head -1
}
state_word() { case "$1" in r|t) echo running;; qw|hqw) echo waiting;; Eqw) echo ERROR;; *) echo "$1";; esac; }

cmd_list() {
  [ -d "$CAMPAIGNS" ] || { say "no campaigns yet. Start one with: bc2 new"; return 0; }
  local n=0 d name j acc want tra mt
  printf '%s%-22s %-10s %-14s %-14s%s\n' "$B" CAMPAIGN JOB "ACCEPTED" "ATTEMPTS" "$N"
  for d in "$CAMPAIGNS"/*/; do
    [ -f "$d/settings.json" ] || continue
    name="$(basename "$d")"; n=$((n+1))
    j="$(job_of "$name")"
    read -r acc want tra mt < <(py progress "${d%/}" | tr '\t' ' ')
    printf '%-22s %-10s %-14s %-14s\n' "$name" "$([ -n "$j" ] && state_word "$(echo "$j" | cut -d' ' -f2)" || echo -)" "$acc / $want" "$tra / $mt"
  done
  [ $n = 0 ] && say "no campaigns yet. Start one with: bc2 new"
  return 0
}

cmd_status() {
  local name="${1:-}"
  [ -z "$name" ] && { cmd_list; return; }
  need_camp "$name"
  local dir j acc want tra mt
  dir="$(camp_dir "$name")"
  j="$(job_of "$name")"
  head1 "Campaign $name"
  if [ -n "$j" ]; then
    set -- $j
    say "  job      : $1  ($(state_word "$2")${3:+, $3})"
    [ "$2" = Eqw ] && warn "the job is in an error state; see: qstat -j $1   (cancel with: bc2 cancel $name)"
    [ "$(state_word "$2")" = waiting ] && say "  ${D}waiting for a free GPU; check queue load with:  qstat -g c -q $(. "$dir/bc2.cfg"; echo "$RQUEUE")${N}"
  else say "  job      : not running"; fi
  read -r acc want tra mt < <(py progress "$dir" | tr '\t' ' ')
  say "  accepted : $acc of $want requested designs"
  say "  attempts : $tra tried (cap: $mt)"
  local lg; lg="$(ls -t "$dir"/logs/bc2_"$name".o* 2>/dev/null | head -1)"
  if [ -n "$lg" ]; then
    say "  log      : $lg"
    say "${D}  last lines:${N}"; tail -n 5 "$lg" | cut -c1-150 | sed 's/^/    /'
  fi
  [ "$acc" -gt 0 ] 2>/dev/null && say "  best designs so far:  bc2 results $name"
  return 0
}

cmd_results() {
  local name="${1:-}" n="${2:-10}"
  need_camp "$name"
  local dir; dir="$(camp_dir "$name")"
  head1 "Top designs for $name"
  py ranked "$dir" "$n"
  say ""
  say "  folder : $dir/results/3_Ranked      (structures .cif, table !_Ranked.csv)"
  say "  all attempts: $dir/results/1_Trajectories"
  say ""
  say "  Copy to your computer (run this on YOUR computer, not on Argon):"
  say "    scp -r $USER@argon.hpc.uiowa.edu:$dir/results/3_Ranked ./${name}_ranked"
}

cmd_cancel() {
  need_camp "${1:-}"
  local j; j="$(job_of "$1")"
  [ -n "$j" ] || { say "'$1' is not queued or running."; return 0; }
  qdel "${j%% *}" >/dev/null 2>&1 && ok "cancelled job ${j%% *}. Run 'bc2 run $1' later to resume." || die "qdel failed"
}

cmd_edit() {
  need_camp "${1:-}"
  local dir; dir="$(camp_dir "$1")"
  # shellcheck disable=SC2086   (EDITOR may hold several words, like "code -w")
  ${EDITOR:-nano} "$dir/settings.json"
  if err="$(py jsoncheck "$dir/settings.json")"; then ok "settings.json is valid JSON. Submit with: bc2 run $1"
  else warn "settings.json has a typo: $err"; warn "run 'bc2 edit $1' again to fix it before submitting"; fi
}

cmd_resources() {
  need_camp "${1:-}"
  local dir; dir="$(camp_dir "$1")"
  ask_resources 0 0
  write_cfg "$dir"
  # keep workers_per_gpu in settings.json in step with what was chosen
  python3 - "$dir/settings.json" "$RWORKERS" <<'PYX'
import json, sys, collections
p, w = sys.argv[1], int(sys.argv[2])
d = json.load(open(p), object_pairs_hook=collections.OrderedDict)
d['workers_per_gpu'] = w
json.dump(d, open(p, 'w'), indent=2); open(p, 'a').write('\n')
PYX
  ok "saved. Submit with: bc2 run $1"
}

cmd_test() {
  load_config
  local name="${1:-smoke-test}"
  say "Creates a tiny campaign (hPDL1, 1 design, at most 4 attempts, 1 worker) to prove your install works end to end."
  export BC_NAME="$name" BC_KIND=shipped BC_TARGET=hPDL1 BC_CHAINS="" BC_HOTSPOTS="" BC_MODALITY=binder BC_PROPS="" \
         BC_LEN_MIN="" BC_LEN_MAX="" BC_NFINAL=1 BC_MAXTRAJ=4 BC_WORKERS=1
  RQUEUE="${BC2_QUEUE:-UI-GPU}"; RGPU="${BC2_GPU:-L40S}"; RSLOTS=8
  create_campaign_files
  ok "created campaign '$name'"
  cmd_run "$name"
}

cmd_help() {
  cat <<EOF
${B}bc2${N} $BC2_VERSION -- run BindCraft2 on Argon without editing files by hand

${B}First time${N}
  bc2 setup                 download the container and AlphaFold weights (runs as a batch job; ~30-60 min once)
  bc2 test                  optional: a tiny run that proves everything works

${B}Every project${N}
  bc2 new [NAME]            guided questions -> a ready-to-run campaign
  bc2 run NAME              submit it (run again to resume after a stop)
  bc2 status [NAME]         what is running and how many designs are accepted
  bc2 results NAME [N]      the best N designs and how to copy them off Argon
  bc2 cancel NAME           stop it (progress is kept)

${B}Tweaking${N}
  bc2 edit NAME             edit settings.json in nano (set EDITOR=vim if you prefer)
  bc2 resources NAME        change GPU type, queue, workers
  bc2 run NAME --dry-run    check the request without submitting
  bc2 list                  all campaigns
  bc2 check                 is the install complete?

Files live in $BC2_HOME  (campaigns in $BC2_HOME/campaigns/NAME).
EOF
}

# ---------------------------------------------------------------- dispatch
sub="${1:-help}"; [ $# -gt 0 ] && shift
case "$sub" in
  setup) cmd_setup "$@";;
  check) cmd_check "$@";;
  new) cmd_new "$@";;
  run|resume|submit) cmd_run "$@";;
  status|st) cmd_status "$@";;
  results|top) cmd_results "$@";;
  cancel|stop) cmd_cancel "$@";;
  list|ls) cmd_list "$@";;
  edit) cmd_edit "$@";;
  resources) cmd_resources "$@";;
  test) cmd_test "$@";;
  _weights_ok) load_config; weights_ok "$AF2DIR";;
  help|-h|--help) cmd_help;;
  version|--version) say "bc2 $BC2_VERSION";;
  *) say "unknown command '$sub'"; cmd_help; exit 1;;
esac
