}
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,40}$ ]]; }

SHIPPED_NAMES=(hPDL1 mPDL1 hIL7RA hIL2R dynorphin_a hPD1)
SHIPPED_RES=(115 116 195 387 40 115)
SHIPPED_DESC=("Human PD-L1 (PD-1 interface as hotspots)  [115 residues]"
              "Mouse PD-L1  [116 residues]"
              "Human IL-7R alpha, one 10-residue patch targeted  [195 residues]"
              "Human IL-2 receptor beta+gamma assembly  [387 residues, two chains]"
